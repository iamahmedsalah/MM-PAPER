NEXT_PUBLIC_SITE_URL=https://mm-eg.co
# Set to 1 for the production build once mm-eg.co serves the site over HTTPS.
REDIRECT_VERCEL_APP=0
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Quote delivery via Hostinger Mail API (API token for info@mm-eg.co)
HOSTINGER_MAIL_API_TOKEN=
QUOTE_TO=info@mm-eg.co

# SMTP settings used when the Mail API token is unset
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@mm-eg.co
SMTP_PASS=
MAIL_FROM="MM Paper Industry <info@mm-eg.co>"

# Official WhatsApp business number (international digits only, no +)
WHATSAPP_NUMBER=201132332148
